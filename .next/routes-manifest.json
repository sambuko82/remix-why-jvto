      "destination": "/tours",
      "statusCode": 307,
      "regex": "^(?!/_next)/tour(?:/([^/]+?))(?:/)?$"
    },
    {
      "source": "/crew/:crewId",
      "destination": "/team/:crewId",
      "statusCode": 308,
      "regex": "^(?!/_next)/crew(?:/([^/]+?))(?:/)?$"
    }
  ],
