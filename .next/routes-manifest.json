      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/verify",
      "destination": "/verify-jvto",
      "statusCode": 308,
      "regex": "^(?!/_next)/verify(?:/)?$"
    },
    {
      "source": "/ijen-health-screening",
      "destination": "/travel-guide/ijen-health-screening",
